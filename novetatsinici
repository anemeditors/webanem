(function() {
  // 1. INJECTAR ESTILS CSS
  const styles = `
    .seccio-coleccio {
      margin-bottom: 70px !important;
      background: linear-gradient(145deg, #f8f9fa, #e9ecef);
      padding: 30px 20px;
      border-radius: 8px;
      box-shadow: inset 0 0 10px rgba(0,0,0,0.03), 0 4px 12px rgba(0,0,0,0.05);
    }
    .titol-coleccio {
      font-size: 1.5em;
      font-weight: bold;
      color: #2b2b2b;
      text-align: center;
      margin-bottom: 25px;
      text-transform: uppercase;
      letter-spacing: 1px;
      position: relative;
    }
    .titol-coleccio::after {
      content: '';
      display: block;
      width: 50px;
      height: 2px;
      background-color: #c00;
      margin: 8px auto 0 auto;
    }
    .slider-passos-wrapper {
      position: relative;
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      overflow: hidden;
      padding: 10px 40px;
      box-sizing: border-box;
    }
    .slider-passos-track-container { overflow: hidden; width: 100%; }
    .slider-passos-track { display: flex; gap: 20px; }
    .slider-passos-track.smooth-transition { transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); }
    .slider-passos-item { flex: 0 0 calc((100% - 60px) / 4); box-sizing: border-box; text-align: center; }
    .slider-passos-item img {
      height: 230px; width: auto; max-width: 100%; object-fit: contain;
      box-shadow: 0 5px 15px rgba(0,0,0,0.18); transition: transform 0.3s, box-shadow 0.3s;
      display: block; margin: 0 auto; background-color: #fff;
    }
    .slider-passos-item img:hover { transform: scale(1.06); box-shadow: 0 10px 22px rgba(0,0,0,0.28); }
    .slider-btn {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: rgba(0, 0, 0, 0.6); color: white; border: none; font-size: 18px;
      width: 38px; height: 38px; border-radius: 50%; cursor: pointer; z-index: 10;
      transition: background 0.3s, transform 0.2s; display: flex; align-items: center; justify-content: center;
    }
    .slider-btn:hover { background: rgba(0, 0, 0, 0.85); transform: translateY(-50%) scale(1.1); }
    .slider-btn-prev { left: 0; }
    .slider-btn-next { right: 0; }
    @media (max-width: 768px) {
      .seccio-coleccio { padding: 20px 10px; margin-bottom: 50px !important; }
      .slider-passos-item { flex: 0 0 calc((100% - 20px) / 2); }
      .slider-passos-item img { height: 180px; }
    }
  `;
  const styleSheet = document.createElement("style");
  styleSheet.innerText = styles;
  document.head.appendChild(styleSheet);

  // 2. CREAR L'ESTRUCTURA HTML DE LES SECCIONS DINS DEL CONTENIDOR
  function crearEstructura(app) {
    app.innerHTML = `
      <div class="seccio-coleccio" id="sec-poesia"><div class="titol-coleccio">Poesia</div><div class="slider-passos-wrapper"><button class="slider-btn slider-btn-prev" id="prev-poesia">&#10094;</button><div class="slider-passos-track-container"><div class="slider-passos-track smooth-transition" id="track-poesia"></div></div><button class="slider-btn slider-btn-next" id="next-poesia">&#10095;</button></div></div>
      <div class="seccio-coleccio" id="sec-textos"><div class="titol-coleccio">Textos i Documents</div><div class="slider-passos-wrapper"><button class="slider-btn slider-btn-prev" id="prev-textos">&#10094;</button><div class="slider-passos-track-container"><div class="slider-passos-track smooth-transition" id="track-textos"></div></div><button class="slider-btn slider-btn-next" id="next-textos">&#10095;</button></div></div>
      <div class="seccio-coleccio" id="sec-universia"><div class="titol-coleccio">Universia</div><div class="slider-passos-wrapper"><button class="slider-btn slider-btn-prev" id="prev-universia">&#10094;</button><div class="slider-passos-track-container"><div class="slider-passos-track smooth-transition" id="track-universia"></div></div><button class="slider-btn slider-btn-next" id="next-universia">&#10095;</button></div></div>
      <div class="seccio-coleccio" id="sec-sastre"><div class="titol-coleccio">Calaix de Sastre</div><div class="slider-passos-wrapper"><button class="slider-btn slider-btn-prev" id="prev-sastre">&#10094;</button><div class="slider-passos-track-container"><div class="slider-passos-track smooth-transition" id="track-sastre"></div></div><button class="slider-btn slider-btn-next" id="next-sastre">&#10095;</button></div></div>
      <div class="seccio-coleccio" id="sec-ripacurtia"><div class="titol-coleccio">Ripacurtia</div><div class="slider-passos-wrapper"><button class="slider-btn slider-btn-prev" id="prev-ripacurtia">&#10094;</button><div class="slider-passos-track-container"><div class="slider-passos-track smooth-transition" id="track-ripacurtia"></div></div><button class="slider-btn slider-btn-next" id="next-ripacurtia">&#10095;</button></div></div>
    `;
  }

  // 3. LÒGICA DELS SLIDERS I LECTURA DEL GOOGLE SHEET
  const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQESjqxo632pyAya7JVHONT0tCGm6XSLnHE1ft4dwY7uIRCUKSiXac8tOj1hYVEkmW-1E7KkPgYv-DR/pub?output=csv';

  function parseCSV(text) {
    let p = '', c = '', r = [];
    let q = false;
    let row = [''];
    for (let i = 0; i < text.length; i++) {
      c = text[i];
      let next = text[i+1];
      if (c === '"') {
        if (q && next === '"') { row[row.length - 1] += '"'; i++; }
        else { q = !q; }
      } else if (c === ',' && !q) {
        row.push('');
      } else if ((c === '\r' || c === '\n') && !q) {
        if (c === '\r' && next === '\n') { i++; }
        r.push(row);
        row = [''];
      } else {
        row[row.length - 1] += c;
      }
    }
    if (row.length > 1 || row[0] !== '') r.push(row);
    return r;
  }

  class ColeccioSliderManual {
    constructor(trackId, prevBtnId, nextBtnId, containerSecId) {
      this.track = document.getElementById(trackId);
      this.prevBtn = document.getElementById(prevBtnId);
      this.nextBtn = document.getElementById(nextBtnId);
      this.containerSec = document.getElementById(containerSecId);
      this.currentIndex = 0;
      this.totalUnics = 0;
      this.isTransitioning = false;

      if (this.prevBtn && this.nextBtn) {
        this.prevBtn.addEventListener('click', () => this.anterior());
        this.nextBtn.addEventListener('click', () => this.seguent());
      }
      window.addEventListener('resize', () => this.moure(false));
    }

    moure(ambAnimacio = true) {
      if (!this.track || this.totalUnics === 0) return;
      if (ambAnimacio) this.track.classList.add('smooth-transition');
      else this.track.classList.remove('smooth-transition');

      const gap = 20;
      const itemWidth = this.track.children[0].getBoundingClientRect().width;
      const desplacament = this.currentIndex * (itemWidth + gap);
      this.track.style.transform = `translateX(-${desplacament}px)`;
    }

    seguent() {
      if (this.isTransitioning) return;
      this.currentIndex++;
      this.moure(true);
      if (this.currentIndex >= this.totalUnics) {
        this.isTransitioning = true;
        setTimeout(() => {
          this.currentIndex = 0;
          this.moure(false);
          this.isTransitioning = false;
        }, 600);
      }
    }

    anterior() {
      if (this.isTransitioning) return;
      if (this.currentIndex <= 0) {
        this.isTransitioning = true;
        this.currentIndex = this.totalUnics;
        this.moure(false);
        setTimeout(() => {
          this.currentIndex--;
          this.moure(true);
          this.isTransitioning = false;
        }, 20);
      } else {
        this.currentIndex--;
        this.moure(true);
      }
    }

    carregarLlibres(llistat) {
      if (!llistat || llistat.length === 0) {
        if (this.containerSec) this.containerSec.style.display = 'none';
        return;
      }
      this.totalUnics = llistat.length;
      const llistaDuplicada = [...llistat, ...llistat];
      let html = '';
      llistaDuplicada.forEach(item => {
        html += `<div class="slider-passos-item"><a href="${item.linkUrl}"><img src="${item.imgUrl}" alt="${item.titol}"></a></div>`;
      });
      this.track.innerHTML = html;
    }
  }

  async function iniciarApp() {
    const app = document.getElementById('cataleg-coleccions-app');
    if (!app) return;

    crearEstructura(app);

    try {
      const response = await fetch(CSV_URL);
      const csvText = await response.text();
      const rows = parseCSV(csvText);
      if (rows.length < 2) return;

      const headers = rows[0].map(h => h.trim().toUpperCase());
      const idxTitol = headers.indexOf('TÍTOL');
      let idxColeccio = headers.indexOf('COL·LECCIÓ');
      if (idxColeccio === -1) idxColeccio = headers.indexOf('COLLECCIO');
      if (idxColeccio === -1) idxColeccio = headers.indexOf('COLECCIO');

      let idxImatge = headers.indexOf('COBERTA') !== -1 ? headers.indexOf('COBERTA') : headers.indexOf('URL COBERTA');
      let idxLink = headers.indexOf('URL LLIBRE') !== -1 ? headers.indexOf('URL LLIBRE') : (headers.indexOf('URL FITXA') !== -1 ? headers.indexOf('URL FITXA') : headers.indexOf('URL'));

      const poesiaList = [], textosList = [], universiaList = [], sastreList = [], ripacurtiaList = [];

      for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        const titol = row[idxTitol] ? row[idxTitol].trim() : '';
        const imgUrl = (idxImatge !== -1 && row[idxImatge]) ? row[idxImatge].trim() : '';
        const linkUrl = (idxLink !== -1 && row[idxLink]) ? row[idxLink].trim() : '#';
        const coleccio = (idxColeccio !== -1 && row[idxColeccio]) ? row[idxColeccio].trim().toLowerCase() : '';

        if (!imgUrl) continue;
        const item = { titol, imgUrl, linkUrl };

        if (coleccio.includes('poesia')) poesiaList.push(item);
        else if (coleccio.includes('textos') || coleccio.includes('documents')) textosList.push(item);
        else if (coleccio.includes('universia')) universiaList.push(item);
        else if (coleccio.includes('sastre') || coleccio.includes('calaix')) sastreList.push(item);
        else if (coleccio.includes('ripacurtia')) ripacurtiaList.push(item);
      }

      new ColeccioSliderManual('track-poesia', 'prev-poesia', 'next-poesia', 'sec-poesia').carregarLlibres(poesiaList);
      new ColeccioSliderManual('track-textos', 'prev-textos', 'next-textos', 'sec-textos').carregarLlibres(textosList);
      new ColeccioSliderManual('track-universia', 'prev-universia', 'next-universia', 'sec-universia').carregarLlibres(universiaList);
      new ColeccioSliderManual('track-sastre', 'prev-sastre', 'next-sastre', 'sec-sastre').carregarLlibres(sastreList);
      new ColeccioSliderManual('track-ripacurtia', 'prev-ripacurtia', 'next-ripacurtia', 'sec-ripacurtia').carregarLlibres(ripacurtiaList);

    } catch (e) {
      console.error('Error carregant sliders:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarApp);
  } else {
    iniciarApp();
  }
})();}

